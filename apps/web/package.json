{
  "name": "@tokenoverflow/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev --port 3000",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "lint": "oxlint --config ../../.oxlintrc.json --deny-warnings --report-unused-disable-directives",
    "format:check": "oxfmt --check --ignore-path ../../.gitignore '**/*.{ts,tsx,js,mjs,cjs}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "gen:api-client": "bash scripts/gen_api_client.sh"
  },
  "dependencies": {
    "@tanstack/solid-router": "1.168.25",
    "@tanstack/solid-start": "1.167.48",
    "@tokenoverflow/config": "workspace:*",
    "cookie": "1.1.1",
    "jose": "6.2.3",
    "pino": "10.3.1",
    "pino-lambda": "4.4.1",
    "solid-js": "1.9.12",
    "valibot": "1.3.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.97.0",
    "@playwright/test": "1.59.1",
    "@tokenoverflow/oxc-config": "workspace:*",
    "@tokenoverflow/tsconfig": "workspace:*",
    "@types/bun": "1.3.12",
    "@types/node": "25.6.0",
    "@vitest/coverage-istanbul": "4.1.5",
    "msw": "2.13.6",
    "nitro": "3.0.260429-beta",
    "pino-pretty": "13.1.2",
    "pino-test": "1.1.0",
    "typescript": "5.9.2",
    "vite": "8.0.10",
    "vite-plugin-solid": "2.11.12",
    "vitest": "4.1.5"
  }
}
